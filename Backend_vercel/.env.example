TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
NEXTAUTH_SECRET=your-secret-minimum-32-chars
# NEXTAUTH_URL n'est plus nécessaire (trustHost: true dans lib/auth.config.ts) —
# ne PAS la définir sur Vercel, sous peine de forcer les redirections vers cette valeur.
